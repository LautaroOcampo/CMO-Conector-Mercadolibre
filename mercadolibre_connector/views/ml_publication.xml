<odoo>
    <!-- Vista para imágenes de variantes (debe estar antes de usarse) -->
    <record id="view_ml_publication_variant_image_list" model="ir.ui.view">
        <field name="name">ml.publication.variant.image.list</field>
        <field name="model">ml.publication.image</field>
        <field name="arch" type="xml">
            <list string="Imágenes de la Variante" editable="bottom" default_order="sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="image_1920" widget="image" options="{'size': [64, 64]}"/>
                <field name="ml_picture_id" readonly="1" optional="hide"/>
                <field name="publication_id" invisible="1"/>
                <field name="variant_id" invisible="1"/>
            </list>
        </field>
        <field name="priority" eval="2"/>
    </record>

    <record id="view_ml_publication_form" model="ir.ui.view">
        <field name="name">ml.publication.form</field>
        <field name="model">ml.publication</field>
        <field name="arch" type="xml">
            <form string="Publicación de Mercado Libre">
                <header>
                    <button name="action_publish_to_ml" 
                            type="object" 
                            string="Publicar en ML"
                            icon="fa-cloud-upload"
                            class="oe_highlight"/>
                    <button name="action_match_product_by_sku" 
                            type="object" 
                            string="Matchear Producto por SKU"
                            icon="fa-link"
                            class="btn-secondary"
                            invisible="product_tmpl_id"/>
                    <button name="action_update_price_from_product" 
                            type="object" 
                            string="💰 Actualizar Precio"
                            icon="fa-money"
                            class="btn-primary"
                            invisible="not product_tmpl_id"
                            help="Actualiza solo el precio desde el producto relacionado y lo sincroniza con MercadoLibre"/>
                    <button name="action_update_stock_from_product" 
                            type="object" 
                            string="📦 Actualizar Stock"
                            icon="fa-cubes"
                            class="btn-primary"
                            invisible="not product_tmpl_id"
                            help="Actualiza solo el stock desde el producto relacionado y lo sincroniza con MercadoLibre"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Nombre"/>
                            <field name="title" string="Título en ML"/>
                            <field name="product_tmpl_id" string="Producto Relacionado"/>
                            <field name="has_product_variants" invisible="1"/>
                            <field name="product_variant_id" string="Variante relacionada" 
                                   invisible="not has_product_variants"
                                   options="{'no_create': True}"
                                   help="Si el producto tiene variantes, indique qué variante corresponde a esta publicación."/>
                            <field name="ml_account_id" string="Cuenta ML"/>
                            <field name="ml_item_id" string="ID Item ML" readonly="1"/>
                            <field name="ml_variation_id" string="ID variación ML" readonly="1" optional="hide" 
                                   invisible="not ml_variation_id"
                                   help="Si está definido, esta fila es una variación del ítem en ML; puede matchear por SKU con un producto/variante de Odoo."/>
                        </group>
                        <group>
                            <group string="Precio y Stock Actuales en ML" col="2">
                                <field name="current_price_ml" string="Precio Actual" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="current_stock_ml" string="Stock Actual"/>
                            </group>
                            <group string="Precio y Stock al Actualizar" col="2">
                                <field name="new_price_ml" string="Precio al Actualizar" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="new_stock_ml" string="Stock al Actualizar"/>
                            </group>
                            <group string="Información Adicional" col="2">
                                <field name="seller_sku" string="SKU" invisible="has_variants"/>
                                <field name="ml_listing_type" string="Tipo de Publicación"/>
                                <field name="ml_status" string="Estado en ML" readonly="1"/>
                                <field name="state" string="Estado" readonly="1"/>
                            </group>
                            <field name="has_variants" invisible="1"/>
                            <!-- Campos legacy para compatibilidad (ocultos) -->
                            <field name="price" invisible="1"/>
                            <field name="stock" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Información del Producto">
                        <group>
                            <group>
                                <field name="category_id" string="ID Categoría ML" readonly="1"/>
                            </group>
                        <group>
                            <field name="local_pickup" string="Ofrece Retiro en Persona"/>
                            <field name="free_shipping" string="Envío Gratis"/>
                            <field name="has_universal_code" string="Tiene Código Universal"/>
                            <field name="universal_code" string="Código Universal" invisible="not has_universal_code"/>
                            <field name="warranty_type" string="Tipo de Garantía"/>
                            <field name="warranty_days" string="Días de Garantía"
                                   invisible="warranty_type == 'none'"
                                   placeholder="Días de garantía"/>
                            <field name="availability_time" string="Tiempo de Disponibilidad"/>
                        </group>
                            </group>
                        </page>
                        <page string="Descripción">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Atributos de Mercado Libre">
                            <div class="alert alert-info" role="alert">
                                <strong>ℹ️</strong> Los atributos se sincronizan desde Mercado Libre al importar la publicación.
                            </div>
                            <group>
                                <field name="ml_attribute_ids" nolabel="1" 
                                       context="{'default_publication_id': id}"
                                       options="{'no_create': True, 'no_open': True}">
                                    <list string="Atributos de Mercado Libre" editable="bottom" 
                                          default_order="sequence,id"
                                          decoration-danger="required and not value_id and not value_name and value_number == 0"
                                          decoration-muted="not required"
                                          create="0">
                                        <field name="sequence" widget="handle" optional="hide"/>
                                        <field name="is_common" string="Común" readonly="1" widget="boolean_toggle" optional="hide"/>
                                        <field name="name" invisible="1"/>
                                        <field name="name_display" string="Atributo" readonly="1"/>
                                        <field name="ml_attribute_id" string="ID ML" readonly="1" optional="hide"/>
                                        <field name="required" string="Obligatorio" readonly="1" widget="boolean_toggle"/>
                                        <field name="value_type" readonly="1" optional="hide"/>
                                        
                                        <field name="value_id"
                                               string="ID Valor"
                                               placeholder="ID del valor (si aplica)"/>
                                        <field name="value_id_display" 
                                               string="Valor seleccionado"
                                               invisible="not value_id"
                                               readonly="1"
                                               optional="hide"/>
                                        <!-- Columna para texto libre (value_name/string) -->
                                        <field name="value_name" 
                                               string="Valor (texto)"
                                               invisible="value_type != 'value_name'"
                                               placeholder="Ingrese el valor del atributo..."/>
                                        <!-- Columnas para números (number/number_unit) -->
                                        <field name="value_number" 
                                               string="Valor numérico"
                                               invisible="value_type not in ['number', 'number_unit']"
                                               placeholder="0.0"/>
                                        <field name="value_unit" 
                                               string="Unidad (texto)"
                                               invisible="value_type != 'number_unit'"
                                               placeholder="kg, cm, etc."/>
                                        <!-- Columna para archivos/imágenes (picture) -->
                                        <field name="value_file" 
                                               string="Archivo/Imagen"
                                               invisible="value_type != 'picture'"
                                               widget="binary"
                                               filename="value_file_name"
                                               help="Suba el archivo o imagen requerido para este atributo"/>
                                        <field name="value_file_name" 
                                               invisible="value_type != 'picture'"
                                               readonly="1"
                                               optional="hide"/>
                                        <field name="valid_values_help" 
                                               string="Ayuda"
                                               invisible="not valid_values_help"
                                               readonly="1"
                                               widget="text"
                                               optional="hide"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Variantes" invisible="not has_variants">
                            <div class="alert alert-info" role="alert">
                                <strong>ℹ️</strong> Al importar desde Mercado Libre, cada variación se crea como una variante con nombre "Título publicación | Nombre variante". 
                                Puede asignar cada variante a un producto/variante de Odoo (columna Producto / Variante Odoo) para tratarlas por separado.
                            </div>
                            <field name="ml_variant_ids" nolabel="1" 
                                   context="{'default_publication_id': id}"
                                   options="{'no_create': True}">
                                <list string="Variantes del Producto" editable="bottom" 
                                      default_order="sequence,id">
                                    <field name="sequence" widget="handle" optional="hide"/>
                                    <field name="display_name" string="Publicación | Variante" readonly="1"/>
                                    <field name="product_variant_id" string="Producto / Variante Odoo" optional="show"/>
                                    <field name="variant_name" string="Nombre variante" optional="hide"/>
                                    <field name="image_1920" widget="image" string="Imagen Legacy" optional="hide"/>
                                    <field name="image_ml_picture_id" string="ID Imagen ML Legacy" readonly="1" optional="hide"/>
                                    <field name="image_ids" string="Imágenes" 
                                           context="{'default_variant_id': id, 'default_publication_id': parent.id, 'skip_ml_publish': True}"
                                           nolabel="1"
                                           options="{'no_create': False}"
                                           view_id="%(view_ml_publication_variant_image_list)d"/>
                                    <field name="price" string="Precio" readonly="1"/>
                                    <field name="available_quantity" string="Cantidad"/>
                                    <field name="seller_sku" string="SKU"/>
                                    <field name="gtin" string="GTIN"/>
                                    <field name="attribute_combination_ids" nolabel="1" context="{'default_variant_id': id}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Imágenes">
                            <div class="alert alert-info" role="alert" invisible="not has_variants">
                                <strong>ℹ️</strong> Si la publicación tiene variantes, puede asignar cada imagen a una variante específica seleccionando la variante en la columna correspondiente.
                            </div>
                            <field name="ml_image_ids"
                                   context="{'default_publication_id': id, 'skip_ml_publish': True}"
                                   nolabel="1"
                                   mode="list,form"
                                   options="{'no_create': False}">
                                <list string="Imágenes de la Publicación" editable="bottom" default_order="sequence,id">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image_1920" widget="image" options="{'size': [64, 64]}"/>
                                    <field name="publication_id" invisible="1"/>
                                    <field name="product_variant_id"
                                           string="Variante del Producto"
                                           invisible="not parent.has_variants"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                           domain="[('product_tmpl_id', '=', parent.product_tmpl_id)]"
                                           placeholder="Seleccione una variante del producto (opcional)"/>
                                    <field name="variant_id" invisible="1"/>
                                    <field name="ml_picture_id" readonly="1" optional="hide"/>
                                </list>
                                <form string="Imagen de publicación">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="image_1920" widget="image" class="oe_avatar"/>
                                            </group>
                                            <group>
                                                <field name="publication_id" invisible="1"/>
                                                <field name="product_variant_id"
                                                       invisible="not parent.has_variants"
                                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                                       domain="[('product_tmpl_id', '=', parent.product_tmpl_id)]"
                                                       placeholder="Seleccione una variante del producto (opcional)"/>
                                                <field name="variant_id" invisible="1"/>
                                                <field name="sequence"/>
                                                <field name="ml_picture_id" readonly="1"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Reglas de Stock" invisible="not ml_account_id">
                            <group>
                                <group string="Regla de Pausa Personalizada">
                                    <div class="alert alert-info" role="alert">
                                        <strong>ℹ️</strong> Si activas esta regla personalizada, esta publicación usará su propio valor de pausa en lugar del valor global de la cuenta.
                                    </div>
                                    <field name="use_custom_pause_rule"/>
                                    <field name="max_stock_to_pause"
                                           invisible="not use_custom_pause_rule"
                                           placeholder="Si está vacío, se usará el valor global de la cuenta"/>
                                </group>
                                <group string="Regla de Activación Personalizada">
                                    <div class="alert alert-info" role="alert">
                                        <strong>ℹ️</strong> Si activas esta regla personalizada, esta publicación usará su propio valor de activación en lugar del valor global de la cuenta.
                                    </div>
                                    <field name="use_custom_activate_rule"/>
                                    <field name="min_stock_to_activate"
                                           invisible="not use_custom_activate_rule"
                                           placeholder="Si está vacío, se usará el valor global de la cuenta"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ml_publication_search" model="ir.ui.view">
        <field name="name">ml.publication.search</field>
        <field name="model">ml.publication</field>
        <field name="arch" type="xml">
            <search string="Publicaciones ML">
                <filter name="con_producto" string="Con producto relacionado" domain="[('product_tmpl_id', '!=', False)]"/>
                <filter name="sin_producto" string="Sin producto relacionado" domain="[('product_tmpl_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_ml_publication_list" model="ir.ui.view">
        <field name="name">ml.publication.list</field>
        <field name="model">ml.publication</field>
        <field name="arch" type="xml">
            <list string="Publicaciones Mercado Libre">
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="current_price_ml" string="Precio en ML" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="current_stock_ml" string="Stock en ML"/>
                <field name="ml_status"/>
                <field name="ml_account_id"/>
                    <!-- 🔵 Activar solo si NO está activa -->
                <button name="action_activate_on_ml"
                        string="🔵 Activar"
                        type="object"
                        class="btn-primary"
                        invisible="ml_status == 'active'"/>
    
                <!-- ⏸️ Pausar solo si está activa -->
                <button name="action_pause_on_ml"
                        string="⏸️ Pausar"
                        type="object"
                        class="btn-secondary"
                        invisible="ml_status == 'paused'"/>
            </list>
        </field>
    </record>

    <record id="action_ml_publication" model="ir.actions.act_window">
        <field name="name">Publicaciones Mercado Libre</field>
        <field name="res_model">ml.publication</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_con_producto': 1}</field>
    </record>

    <menuitem id="menu_ml_root" name="Mercado Libre"/>
    <menuitem id="menu_ml_publication"
              name="Publicaciones"
              parent="menu_ml_root"
              action="action_ml_publication"/>

    <!-- Acciones masivas: Pausar / Activar en ML (aparecen en el menú Acción al seleccionar publicaciones) -->
    <record id="action_ml_publication_pause_mass" model="ir.actions.server">
        <field name="name">⏸️ Pausar en Mercado Libre</field>
        <field name="model_id" ref="model_ml_publication"/>
        <field name="binding_model_id" ref="model_ml_publication"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_pause_on_ml()</field>
    </record>
    <record id="action_ml_publication_activate_mass" model="ir.actions.server">
        <field name="name">🔵 Activar en Mercado Libre</field>
        <field name="model_id" ref="model_ml_publication"/>
        <field name="binding_model_id" ref="model_ml_publication"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_activate_on_ml()</field>
    </record>

    <record id="view_ml_publication_image_form" model="ir.ui.view">
        <field name="name">ml.publication.image.form</field>
        <field name="model">ml.publication.image</field>
        <field name="arch" type="xml">
            <form string="Imagen de publicación">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_ml_publication_image_list" model="ir.ui.view">
        <field name="name">ml.publication.image.list</field>
        <field name="model">ml.publication.image</field>
        <field name="arch" type="xml">
            <list string="Imágenes" editable="bottom" default_order="sequence,id">
                <field name="sequence" widget="handle" optional="hide"/>
                <field name="image_1920" widget="image" options="{'size': [64, 64]}"/>
                <field name="variant_id" 
                       string="Variante"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                       domain="[('publication_id', '=', publication_id)]"
                       placeholder="Seleccione una variante (opcional)"/>
                <field name="ml_picture_id" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>
    
    <!-- Vista de formulario para imágenes de publicación (con selector de variante) -->
    <record id="view_ml_publication_image_form_with_variant" model="ir.ui.view">
        <field name="name">ml.publication.image.form.with.variant</field>
        <field name="model">ml.publication.image</field>
        <field name="arch" type="xml">
            <form string="Imagen de publicación">
                <sheet>
                    <group>
                        <group>
                            <field name="image_1920" widget="image" class="oe_avatar"/>
                        </group>
                        <group>
                            <field name="publication_id" invisible="context.get('default_publication_id')"/>
                            <field name="variant_id" 
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('publication_id', '=', publication_id)]"
                                   placeholder="Seleccione una variante (opcional)"/>
                            <field name="sequence"/>
                            <field name="ml_picture_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista para atributos de variante -->
    <record id="view_ml_publication_variant_attribute_list" model="ir.ui.view">
        <field name="name">ml.publication.variant.attribute.list</field>
        <field name="model">ml.publication.variant.attribute</field>
        <field name="arch" type="xml">
            <list string="Atributos de la variante" editable="bottom" default_order="sequence,id">
                <field name="sequence" widget="handle" optional="hide"/>
                <field name="ml_attribute_id" string="ID ML"/>
                <field name="name" string="Nombre atributo"/>
                <field name="value_name" string="Valor"/>
                <field name="value_id" string="ID Valor" optional="hide"/>
            </list>
        </field>
        <field name="priority" eval="1"/>
    </record>

    
</odoo>

