<odoo>
    <data>
        <!-- Grupo base: solo lectura -->
        <record id="group_ml_user" model="res.groups">
            <field name="name">Usuario ML</field>
            <field name="category_id"
                   ref="base.module_category_sales_sales"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo medio: operaciones -->
        <record id="group_ml_manager" model="res.groups">
            <field name="name">Gestor ML</field>
            <field name="category_id"
                   ref="base.module_category_sales_sales"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_ml_user'))]"/>
        </record>

        <!-- Grupo alto: configuración completa -->
        <record id="group_ml_admin" model="res.groups">
            <field name="name">Administrador ML</field>
            <field name="category_id"
                   ref="base.module_category_sales_sales"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_ml_manager'))]"/>
        </record>
    </data>
</odoo>