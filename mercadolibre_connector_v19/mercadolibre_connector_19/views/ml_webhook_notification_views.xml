<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ml_webhook_notification_tree" model="ir.ui.view">
        <field name="name">ml.webhook.notification.list</field>
        <field name="model">ml.webhook.notification</field>
        <field name="arch" type="xml">
            <list string="Notificaciones webhook ML" default_order="date_received desc">
                <field name="date_received"/>
                <field name="order_id"/>
                <field name="topic"/>
                <field name="status"/>
                <field name="retry_count"/>
                <field name="ml_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ml_webhook_notification_form" model="ir.ui.view">
        <field name="name">ml.webhook.notification.form</field>
        <field name="model">ml.webhook.notification</field>
        <field name="arch" type="xml">
            <form string="Notificación webhook ML">
                <header>
                    <button name="action_retry_webhook_notification"
                            string="Reintentar"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'failed'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="topic"/>
                            <field name="resource"/>
                            <field name="user_id"/>
                            <field name="status"/>
                            <field name="retry_count"/>
                        </group>
                        <group>
                            <field name="ml_account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_received"/>
                        </group>
                    </group>
                    <group string="Payload">
                        <field name="raw_data" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ml_webhook_notification_search" model="ir.ui.view">
        <field name="name">ml.webhook.notification.search</field>
        <field name="model">ml.webhook.notification</field>
        <field name="arch" type="xml">
            <search string="Notificaciones webhook">
                <field name="order_id"/>
                <field name="topic"/>
                <field name="ml_account_id"/>
                <field name="status"/>
                <filter string="Fallidas" name="failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Pendientes" name="pending" domain="[('status', '=', 'pending')]"/>
            </search>
        </field>
    </record>

    <record id="action_ml_webhook_notification" model="ir.actions.act_window">
        <field name="name">Notificaciones webhook ML</field>
        <field name="res_model">ml.webhook.notification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ml_webhook_notification_search"/>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_ml_webhook_notification"
              name="Notificaciones webhook"
              parent="menu_ml_root"
              action="action_ml_webhook_notification"
              sequence="45"/>
</odoo>
