<odoo>
    <record id="view_product_form_inherit_ml" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ml</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Insertamos una nueva página dedicada a Mercado Libre -->
            <xpath expr="//notebook" position="inside">
                <page string="Mercado Libre">
                    <!-- 🔹 Tabla de publicaciones vinculadas -->
                    <field name="ml_publication_ids"
                           context="{'default_product_tmpl_id': id}"
                           view_mode="list,form"
                           options="{'no_create': True, 'no_create_edit': True}"
                           views="[(list, ref('view_ml_publication_list')),
                                   (form, ref('view_ml_publication_form'))]"/>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
