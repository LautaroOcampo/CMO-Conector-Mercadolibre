<odoo>
    <!-- ========================= -->
    <!-- 📦 VISTAS DE CUENTAS ML -->
    <!-- ========================= -->
    
<record id="view_ml_account_form" model="ir.ui.view">
        <field name="name">ml.account.form</field>
        <field name="model">ml.account</field>
        <field name="arch" type="xml">
            <form string="Cuenta de Mercado Libre">
                <header>
                    <button name="action_open_authorize"
                            string="Autorizar cuenta"
                            type="object"
                            class="oe_highlight"/>

                    <button name="action_test_connection"
                            string="Probar Conexión"
                            type="object"
                            class="btn-primary"
                            icon="fa-plug"/>

                    <button name="action_refresh_token"
                            string="Refrescar token"
                            type="object"/>
                    
                    <button name="action_match_all_publications_by_sku"
                            string="Matchear Todas las Publicaciones por SKU"
                            type="object"
                            icon="fa-link"
                            class="btn-secondary"/>
                    
                    <button name="action_import_all_publications_from_ml"
                            string="Importar Todas las Publicaciones desde MELI"
                            type="object"
                            icon="fa-download"
                            class="btn-primary"
                            invisible="import_publications_active"/>
                    <button name="action_stop_import_publications"
                            string="Detener importación"
                            type="object"
                            icon="fa-stop"
                            class="btn-warning"
                            invisible="not import_publications_active"/>
                    
                    <button name="action_update_all_publications_stock"
                            string="📦 Actualizar Stock de Todas las Publicaciones"
                            type="object"
                            icon="fa-cubes"
                            class="btn-primary"
                            help="Actualiza solo el stock de todas las publicaciones desde los productos relacionados y sincroniza con MercadoLibre"/>
                    
                    <button name="action_open_import_orders_wizard"
                            string="📦 Importar Todas las Órdenes de Venta"
                            type="object"
                            icon="fa-shopping-cart"
                            class="btn-success"/>
                    
                    <!-- Botón Mercado Envíos eliminado por solicitud del usuario -->
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sync_log_errors"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exclamation-triangle"
                                groups="base.group_user"
                                invisible="sync_log_error_recent_count == 0">
                            <field name="sync_log_error_recent_count" widget="statinfo"
                                   string="Errores sync (30 días)"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="oauth_via_hub" invisible="1"/>
                            <field name="oauth_is_hub" invisible="1"/>
                            <div class="alert alert-info" role="alert"
                                 invisible="not oauth_via_hub or oauth_is_hub">
                                Esta base autoriza vía <b>hub OAuth</b>. No hace falta
                                Client ID/Secret locales: se reciben al autorizar.
                                Registrá una sola Redirect URI en la app de Mercado Libre
                                (la del hub).
                            </div>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not oauth_is_hub">
                                Esta base es el <b>hub OAuth</b> (app central de los clientes)
                                y también puede autorizar una cuenta local acá. Usá un
                                usuario de Mercado Libre <b>distinto</b> al de cualquier
                                cliente. Redirect URI a registrar en developers.mercadolibre.com:
                            </div>
                            <field name="oauth_callback_uri" readonly="1"
                                   invisible="not oauth_is_hub and oauth_via_hub"/>
                            <field name="client_id"
                                   invisible="oauth_via_hub and not oauth_is_hub"/>
                            <field name="client_secret" password="True"
                                   groups="group_ml_admin"
                                   invisible="oauth_via_hub and not oauth_is_hub"/>
                            <field name="redirect_uri"
                                   placeholder="https://su-dominio.odoo.com/mercadolibre/oauth/callback"
                                   invisible="oauth_via_hub and not oauth_is_hub"
                                   help="Debe coincidir EXACTAMENTE con la URL de redirección registrada en developers.mercadolibre.com. Si está vacía o es solo la ruta, se usa web.base.url + /mercadolibre/oauth/callback."/>
                        </group>
                        <group string="Configuración del stock">
                            <field name="warehouse_id"
                                   options="{'no_create': False}"
                                   placeholder="Almacén depósito → Flex / multi-origen en ML"/>
                            <field name="has_meli_full"/>
                            <field name="full_warehouse_id"
                                   invisible="not has_meli_full"
                                   required="has_meli_full"
                                   options="{'no_create': False}"
                                   placeholder="Almacén desde el que se descuenta stock en ventas Full"/>
                            <field name="stock_type"/>
                            <field name="auto_sync_stock_on_odoo_change"/>
                            <field name="sync_stock_reactivate_out_of_stock"/>
                            <field name="auto_pause_when_max_stock"/>
                            <field name="max_stock_to_pause"
                                   invisible="not auto_pause_when_max_stock"
                                   placeholder="Máximo de stock para pausar (ej: 5)"/>
                            <div class="alert alert-info" role="alert" invisible="not auto_pause_when_max_stock">
                                <p><strong>Pausa global:</strong> si el stock del depósito es menor o igual al máximo, la publicación se pausa en Mercado Libre. Cada publicación puede pisar este valor en su ficha.</p>
                            </div>
                            <field name="auto_activate_when_min_stock"/>
                            <field name="min_stock_to_activate"
                                   invisible="not auto_activate_when_min_stock"
                                   placeholder="Mínimo de stock para activar (ej: 10)"/>
                            <div class="alert alert-info" role="alert" invisible="not auto_activate_when_min_stock">
                                <p><strong>Activación global:</strong> si el stock del depósito es mayor o igual al mínimo (mayor a 0), la publicación pausada se vuelve a activar. Cada publicación puede pisar este valor en su ficha.</p>
                            </div>
                        </group>
                        <group string="Importación a Odoo">
                            <field name="auto_create_sale_order"/>
                            <field name="auto_create_invoice" invisible="not auto_create_sale_order"/>
                            <field name="default_tax_id"
                                   options="{'no_create': False}"
                                   placeholder="Seleccioná el impuesto por defecto (opcional)"
                                   invisible="not auto_create_invoice"/>
                            <field name="invoice_journal_id"
                                   options="{'no_create': False}"
                                   placeholder="Seleccioná el diario para facturas automáticas"
                                   invisible="not auto_create_invoice"/>
                            <field name="default_income_account_id"
                                   options="{'no_create': False}"
                                   placeholder="Seleccioná la cuenta de ingresos para facturas ML"
                                   invisible="not auto_create_invoice"/>
                            <field name="ml_commission_account_id"
                                   options="{'no_create': False}"
                                   placeholder="Cuenta de gasto para asiento de comisión ML"
                                   invisible="not auto_create_invoice"/>
                            <field name="fallback_product_id"
                                   options="{'no_create': False}"
                                   placeholder="Seleccioná producto fallback para errores SKU"/>
                            <field name="auto_invoice_with_fallback_product"
                                   invisible="not fallback_product_id"/>
                            <div class="alert alert-info" role="alert" invisible="not auto_invoice_with_fallback_product">
                                <p><strong>Fallback facturable:</strong> ventas con SKU/publicación no identificada se confirman y facturan con el producto fallback; en el PDF aparece el título de Mercado Libre. Requiere producto fallback y factura automática activos.</p>
                            </div>
                            <field name="default_order_partner_id"
                                   options="{'no_create': False}"
                                   placeholder="Consumidor Final para ventas ML"/>
                            <field name="never_create_order_contacts"/>
                            <div class="alert alert-info" role="alert" invisible="not never_create_order_contacts">
                                <p><strong>Sin contactos nuevos:</strong> no se crean compradores en Odoo. No B2B → Consumidor Final. B2B → contacto existente (buyer ID / CUIT) con datos fiscales; si no hay match, Consumidor Final.</p>
                            </div>
                            <field name="payment_journal_id"
                                   options="{'no_create': False}"
                                   placeholder="Diario banco/misc. para asiento de comisión ML"
                                   invisible="not auto_create_invoice"/>
                        </group>
                        <group string="Importación de ventas">
                            <field name="process_webhook_sales"/>
                            <field name="webhook_active_since"
                                   readonly="1"
                                   invisible="not process_webhook_sales"/>
                            <field name="webhook_last_received_at" readonly="1"/>
                            <field name="webhook_last_status" readonly="1"/>
                            <field name="webhook_last_summary" readonly="1"/>
                            <field name="enable_order_polling"/>
                            <field name="polling_active_since"
                                   invisible="not enable_order_polling"/>
                            <field name="polling_hours_back"
                                   invisible="not enable_order_polling"
                                   placeholder="24"/>
                            <div class="alert alert-info" role="alert">
                                <p><strong>Go-live:</strong> al activar el webhook se guarda «Webhook activo desde». Solo entran ventas ML creadas después de ese momento; notificaciones de órdenes viejas se ignoran.</p>
                                <p><strong>Diagnóstico webhook:</strong> en los logs buscar <code>[ML WEBHOOK][HEALTH]</code>. Los campos «Último webhook» se actualizan con cada notificación HTTP.</p>
                            </div>
                        </group>
                        <group string="Importación de publicaciones">
                            <field name="import_publications_active" readonly="1"/>
                            <field name="import_publications_offset" readonly="1" invisible="not import_publications_active"/>
                            <field name="import_publications_total" readonly="1" invisible="not import_publications_active"/>
                            <field name="import_publications_batch_size" invisible="import_publications_active"/>
                            <field name="import_download_images" invisible="import_publications_active"/>
                            <field name="scan_new_publications_enabled" invisible="import_publications_active"/>
                            <field name="scan_new_publications_import_limit"
                                   invisible="not scan_new_publications_enabled or import_publications_active"/>
                            <field name="scan_new_publications_last_run" readonly="1"
                                   invisible="not scan_new_publications_enabled"/>
                            <field name="scan_new_publications_last_imported" readonly="1"
                                   invisible="not scan_new_publications_enabled"/>
                            <div class="alert alert-info" role="alert" invisible="import_publications_active">
                                <p><strong>Importación masiva:</strong> primero lista todo el catálogo con <code>search_type=scan</code> (soporta más de 1000 publicaciones) y luego procesa en segundo plano (~1 lote por minuto). Cada ítem se confirma en base de datos; al reanudar se omiten los ya importados.</p>
                                <p><strong>Imágenes:</strong> desactivado = solo IDs de imagen ML (recomendado para catálogos grandes).</p>
                                <p><strong>Scan diario de novedades:</strong> una vez al día vuelve a listar el catálogo (~40 llamadas API para ~4000 ítems, solo IDs) e importa únicamente MLA que aún no están en Odoo. No corre durante una importación masiva activa.</p>
                            </div>
                            <div class="alert alert-warning" role="alert" invisible="not import_publications_active">
                                <p><strong>Importación en curso</strong> (progreso <field name="import_publications_offset" readonly="1" nolabel="1" class="oe_inline"/> / <field name="import_publications_total" readonly="1" nolabel="1" class="oe_inline"/>). Revise Publicaciones ML y los logs del servidor.</p>
                            </div>
                        </group>
                        <group string="País y zona horaria (Mercado Libre)">
                            <field name="country_id" options="{'no_create': True}"/>
                            <field name="timezone"/>
                        </group>
                    </group>

                    <group string="Tokens de acceso">
                        <field name="access_token" readonly="1" groups="group_ml_admin"/>
                        <field name="refresh_token" readonly="1" groups="group_ml_admin"/>
                        <field name="token_expiration" readonly="1"/>
                        <field name="is_connected" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista tipo lista -->
    <record id="view_ml_account_list" model="ir.ui.view">
        <field name="name">ml.account.list</field>
        <field name="model">ml.account</field>
        <field name="arch" type="xml">
            <list string="Cuentas Mercado Libre">
                <field name="name"/>
                <field name="country_id"/>
                <field name="warehouse_id"/>
                <field name="is_connected"/>
                <field name="token_expiration"/>
            </list>
        </field>
    </record>

    <!-- Acción -->


