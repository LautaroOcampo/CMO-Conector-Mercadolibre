<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extender formulario de orden de venta: origen y smart button a venta ML -->
    <record id="view_order_form_inherit_ml" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ml</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Campo Origen en la cabecera (junto a cliente/origen estándar) -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_origin" optional="show"/>
            </xpath>
            <!-- Smart button a Venta Mercado Libre -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_ml_sale"
                        icon="fa-shopping-cart" invisible="not ml_sale_id">
                    <span class="o_stat_text">Mercado Libre</span>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Mercado Libre" name="ml_sale_payload" invisible="sale_origin != 'mercadolibre'">
                    <group>
                        <group string="Venta vinculada">
                            <field name="ml_sale_id" string="Venta ML" readonly="1"/>
                            <field name="ml_order_id" readonly="1"/>
                            <field name="ml_pack_id" readonly="1"/>
                            <field name="ml_commission_amount" readonly="1"/>
                        </group>
                    </group>
                    <group string="Ventas ML del pedido (pack)" invisible="not ml_sale_ids">
                        <field name="ml_sale_ids" nolabel="1" readonly="1" colspan="2">
                            <list create="false" delete="false" edit="false">
                                <field name="ml_order_id" string="ID ML"/>
                                <field name="ml_pack_id" string="Pack" optional="show"/>
                                <field name="customer_name" string="Cliente"/>
                                <field name="total_amount" string="Total"/>
                                <field name="status" string="Estado"/>
                                <field name="date_created" string="Fecha"/>
                            </list>
                        </field>
                    </group>
                    <separator string="Payload ML (JSON)"/>
                    <field name="ml_order_payload" nolabel="1" readonly="1" widget="text"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Lista de órdenes: columna Origen para filtrar/agrupar -->
    <record id="view_order_tree_inherit_ml" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.ml</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_origin" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
