<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_groups_privilege_mercadolibre" model="res.groups.privilege">
            <field name="name">Mercado Libre</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="placeholder">Sin acceso</field>
        </record>

        <record id="group_ml_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_mercadolibre"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Ve publicaciones y ventas. No ve cuentas, credenciales ni acciones de administración.</field>
        </record>

        <record id="group_ml_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_mercadolibre"/>
            <field name="implied_ids" eval="[(4, ref('group_ml_user'))]"/>
            <field name="comment">Acceso completo, incluida la administración de la cuenta.</field>
        </record>
    </data>
</odoo>
